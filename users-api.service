[Unit]
Description=Private Users FastAPI
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/users-api
EnvironmentFile=/opt/users-api/.env
ExecStart=/opt/users-api/venv/bin/uvicorn fastapi_app:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
